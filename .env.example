# Creator Cash Flow Backend Environment Variables
PORT=5000
NODE_ENV=production

# Supabase Auth & PostgreSQL Credentials
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Security & Encryption Secrets (256-bit Key)
JWT_SECRET=super-secret-jwt-key-creator-cash-flow-2026
ENCRYPTION_KEY=32-character-random-secret-key-encryption

# External API URLs
PHYLLO_API_URL=https://api.staging.getphyllo.com
RESEND_API_URL=https://api.resend.com
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta

# External API Keys
PHYLLO_CLIENT_ID=your-phyllo-client-id
PHYLLO_CLIENT_SECRET=your-phyllo-client-secret
# Legacy alternative: a complete Basic authorization value.
# PHYLLO_AUTH_HEADER=Basic your-base64-client-id-and-secret
# Use sandbox until Phyllo approves the production application and redirect domains.
PHYLLO_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
RESEND_API_KEY=your-resend-api-key
GEMINI_API_KEY=your-gemini-api-key

# Frontend API URL
FRONTEND_API_URL=https://creator-cash-flow.onrender.com/api

# Plaid Sandbox Credentials
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-sandbox-secret
